// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String            @id @default(uuid())
  fullName      String
  email         String            @unique
  phone         String
  passwordHash  String
  role          String            // "applicant", "admissions_officer", "admin", "super_admin"
  isVerified    Boolean           @default(false)
  mailingAddress String?
  kinName        String?
  kinPhone       String?
  kinRelation    String?
  mfaEnabled     Boolean           @default(false)
  mfaSecret      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  applications  Application[]
  reviews       Application[]     @relation("ReviewedApplications")
  letters       AdmissionLetter[] @relation("IssuedLetters")
  notifications Notification[]
  logs          AuditLog[]
  tickets       Ticket[]          @relation("UserTickets")
  messages      TicketMessage[]   @relation("SenderMessages")
}

model Programme {
  id                  String        @id @default(uuid())
  name                String
  code                String        @unique
  level               String        // "Certificate", "Diploma"
  duration            String        // e.g. "2 Years", "3 Years"
  minGradeRequirement String        // JSON string (e.g. { "meanGrade": "C-", "subjects": { "english": "C", "math": "D" } })
  intakeCapacity      Int
  intakePeriod        String        // e.g. "September 2026"
  isActive            Boolean       @default(true)
  feesStructure       String        // JSON string storing semester fees breakdown
  
  primaryApplications   Application[] @relation("PrimaryApplications")
  secondaryApplications Application[] @relation("SecondaryApplications")
}

model Application {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  programmeId       String
  programme         Programme        @relation("PrimaryApplications", fields: [programmeId], references: [id], onDelete: Restrict)
  secondaryProgrammeId String?
  secondaryProgramme   Programme?      @relation("SecondaryApplications", fields: [secondaryProgrammeId], references: [id], onDelete: SetNull)
  
  status            String           // "draft", "submitted", "eligibility_passed", "eligibility_failed", "under_review", "admitted", "rejected", "letter_issued"
  personalDetails   String           // JSON string storing dob, gender, idNumber, county, etc.
  kcseIndexNo       String
  kcseYear          Int
  kcseMeanGrade     String
  subjectGrades     String           // JSON string storing subject -> grade mapping
  eligibilityResult String?          // JSON string storing { eligible: boolean, checks: Array }
  
  paymentStatus     String           @default("unpaid") // "unpaid", "pending", "paid"
  paymentMethod     String?          // "mpesa" or "bank"
  paymentReference  String?          // M-Pesa code or bank slip ID
  paymentAmount     Float?
  paymentVerifiedAt DateTime?
  paymentSlipUrl    String?
  paymentReceiptUrl String?
  summaryReceiptUrl String?
  
  submittedAt       DateTime?
  reviewedById      String?
  reviewedBy        User?            @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  documents         Document[]
  admissionLetter   AdmissionLetter?
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String      // "id_copy", "kcse_cert", "photo", "birth_cert"
  fileUrl       String      // relative local file path or base64 data URL for testing
  fileName      String
  uploadedAt    DateTime    @default(now())
  verified      Boolean     @default(false)
}

model AdmissionLetter {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  serialNumber  String      @unique
  pdfUrl        String
  issuedAt      DateTime    @default(now())
  reportingDate String
  generatedById String
  generatedBy   User        @relation("IssuedLetters", fields: [generatedById], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   // "email", "sms"
  subject   String?
  message   String
  status    String   // "sent", "failed"
  sentAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String   // e.g. "submit_application", "approve_application", "login"
  entity    String   // e.g. "Application"
  entityId  String
  ipAddress String?
  timestamp DateTime @default(now())
}

model Ticket {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  category    String          // "payment", "documents", "technical", "other"
  status      String          @default("open") // "open", "resolved"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}
